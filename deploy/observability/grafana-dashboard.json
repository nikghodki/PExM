{
  "__inputs": [],
  "__requires": [
    { "type": "grafana",     "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource",  "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "ContextOS — Memory OS Dashboard",
  "uid": "contextos-main",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Memory Operations / sec",
      "targets": [
        {
          "expr": "rate(contextos_memory_ops_total[1m])",
          "legendFormat": "ops/sec"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "P95 Retrieval Latency (ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(contextos_retrieval_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p95 ms"
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Sessions",
      "targets": [
        {
          "expr": "contextos_active_sessions",
          "legendFormat": "sessions"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory Tier Distribution",
      "targets": [
        { "expr": "contextos_memories_by_tier{tier='l1'}", "legendFormat": "L1 Session" },
        { "expr": "contextos_memories_by_tier{tier='l2'}", "legendFormat": "L2 Task" },
        { "expr": "contextos_memories_by_tier{tier='l3'}", "legendFormat": "L3 Semantic" },
        { "expr": "contextos_memories_by_tier{tier='l4'}", "legendFormat": "L4 Archive" }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Bus Event Throughput",
      "targets": [
        {
          "expr": "rate(contextos_bus_events_total[1m])",
          "legendFormat": "events/sec"
        }
      ],
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
    }
  ]
}
